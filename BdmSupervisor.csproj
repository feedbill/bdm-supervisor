<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- msxfs.dll (XFS Manager) es de 32 bits en casi todas las instalaciones: la app DEBE ser x86 -->
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <AssemblyName>BdmSupervisor</AssemblyName>
    <RootNamespace>BdmSupervisor</RootNamespace>
    <Version>0.7.0</Version>
    <Company>Feedbill</Company>
    <Product>BDM-500 Supervisor</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="XfsCheck\**" />
    <None Remove="XfsCheck\**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\bdm500.png" />
    <Resource Include="Resources\bne_s110m.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

