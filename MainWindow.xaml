<Window x:Class="BdmSupervisor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BDM-500 Supervisor · Feedbill" Height="900" Width="1280" MinHeight="760" WindowState="Maximized"
        WindowStartupLocation="CenterScreen" Background="White" FontFamily="Segoe UI">
    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Dark}" Padding="20,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="feedbill" Foreground="{StaticResource Brand}" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="  BDM-500 Supervisor" Foreground="White" FontSize="20" Margin="4,2,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="DeviceDot" Width="14" Height="14" Fill="{StaticResource Muted}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="DeviceText" Text="No conectado" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                    <Border x:Name="ModeBadge" Background="{StaticResource Muted}" CornerRadius="4" Padding="10,4" Margin="20,0,0,0">
                        <TextBlock x:Name="ModeText" Text="SUPERVISOR INACTIVO" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Aviso TestTool -->
        <Border x:Name="TestToolBar" DockPanel.Dock="Top" Background="#FFF4D6" BorderBrush="#E0A100" BorderThickness="0,0,0,1" Padding="16,8" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="REPARAR" Click="RepairTestTool_Click" MinHeight="32" MinWidth="110" Padding="12,4" Margin="12,0,0,0"/>
                <TextBlock x:Name="TestToolText" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13"/>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" Padding="16,8">
            <DockPanel>
                <TextBlock x:Name="StatusBar" Text="Listo" FontSize="13" Foreground="{StaticResource Muted}"/>
                <ProgressBar x:Name="Busy" DockPanel.Dock="Right" Width="160" Height="6" IsIndeterminate="True" Visibility="Collapsed" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" Margin="0" BorderThickness="0">

            <!-- ESTADO -->
            <TabItem Header="Estado">
                <Grid Margin="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <Image Source="pack://application:,,,/Resources/bdm500.png" Width="180" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,8,0,8"/>
                        <TextBlock Text="SNBC BDM-500" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Depositario de billetes" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="SerialText" Style="{StaticResource Label}" Text="" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,24,0">
                        <TextBlock Style="{StaticResource H1}" Text="Módulos"/>
                        <ItemsControl x:Name="ModuleList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Panel}" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                                        <DockPanel>
                                            <Ellipse Width="14" Height="14" Fill="{Binding Brush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" FontSize="16" VerticalAlignment="Center"/>
                                            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding Value}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="ACTUALIZAR ESTADO" Click="Refresh_Click" Style="{StaticResource Primary}" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource H1}" Text="Unidades de efectivo"/>
                        <DataGrid x:Name="CashUnitsGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" FontSize="15" RowHeight="36" BorderThickness="0" Background="White">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="40"/>
                                <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="*"/>
                                <DataGridTextColumn Header="ID" Binding="{Binding UnitId}" Width="80"/>
                                <DataGridTextColumn Header="Billetes" Binding="{Binding Count}" Width="90"/>
                                <DataGridTextColumn Header="Máx." Binding="{Binding Maximum}" Width="80"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Style="{StaticResource Label}" Text="Service Provider" Margin="0,20,0,0"/>
                        <TextBlock x:Name="SpText" Style="{StaticResource Value}" Text="—"/>
                        <TextBlock Style="{StaticResource Label}" Text="Extra (firmware / template)"/>
                        <TextBlock x:Name="ExtraText" Style="{StaticResource Value}" Text="—" TextWrapping="Wrap" FontSize="14"/>
                        <TextBlock Style="{StaticResource Label}" Text="Última lectura"/>
                        <TextBlock x:Name="TsText" Style="{StaticResource Value}" Text="—" FontSize="14"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- SUPERVISOR: botones a la izquierda, diagrama al centro, indicadores a la derecha -->
            <TabItem Header="Supervisor" x:Name="SupervisorTab">
                <Grid Margin="16,12,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="230"/>
                    </Grid.ColumnDefinitions>

                    <!-- Izquierda: botones, alineados con los indicadores de la derecha (misma grilla de 9 filas) -->
                    <UniformGrid Grid.Row="0" Grid.Column="0" Rows="9" Columns="1">
                        <UniformGrid.Resources>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource Dark}"/>
                                <Setter Property="BorderBrush" Value="#D0D0D6"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="1" CornerRadius="7" Padding="10,5">
                                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left">
                                                    <ContentPresenter.Resources>
                                                        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                                                    </ContentPresenter.Resources>
                                                </ContentPresenter>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brand}"/></Trigger>
                                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.8"/></Trigger>
                                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </UniformGrid.Resources>
                        <Button x:Name="SupervisorBtn" Content="ENTRAR EN MODO SUPERVISOR" Click="SupervisorToggle_Click"/>
                        <Button Content="PRUEBA DE DEPÓSITO" Click="TestDeposit_Click"/>
                        <Button Content="RESET DEL EQUIPO" Click="Reset_Click"/>
                        <Button Content="CAMBIO DE BOLSA" Click="BagExchange_Click"/>
                        <Button x:Name="EscrowBtn" Content="ABRIR ESCROW" Click="ToggleEscrow_Click"/>
                        <Button x:Name="DropBtn" Content="ABRIR COMPUERTA DE CAÍDA" Click="ToggleDrop_Click"/>
                        <Button Content="PROBAR ALETEO" Click="Flutter_Click"/>
                    </UniformGrid>

                    <!-- Centro: diagrama -->
                    <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,12,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border x:Name="ValidatorBar" Grid.Row="0" CornerRadius="7" Background="#B8B8BE" Padding="14,8" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="ValidatorTitle" Text="VALIDADOR: SIN LECTURA" Foreground="White" FontSize="18" FontWeight="Bold"/>
                                <TextBlock x:Name="ValidatorDetail" Text="Iniciando lectura en vivo..." Foreground="White" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top">
                            <Grid Width="352" Height="383">
                                <Image Source="pack://application:,,,/Resources/bne_s110m.png" Stretch="Fill"/>
                                <Canvas x:Name="SensorCanvas" Width="352" Height="383"/>
                            </Grid>
                        </Viewbox>
                        <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Rectangle Width="16" Height="16" Fill="#3C78D8" Opacity="0.8" Margin="0,0,5,0"/>
                            <TextBlock Text="Libre" FontSize="13" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Rectangle Width="16" Height="16" Fill="#D1333B" Opacity="0.85" Margin="0,0,5,0"/>
                            <TextBlock Text="Tapado" FontSize="13" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Rectangle Width="16" Height="16" Stroke="#D1333B" StrokeThickness="3" Fill="#33D1333B" RadiusX="4" RadiusY="4" Margin="0,0,5,0"/>
                            <TextBlock Text="Atasco / error" FontSize="13" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Rectangle Width="16" Height="16" Stroke="#F08C00" StrokeThickness="3" StrokeDashArray="2,1" Fill="#46F08C00" RadiusX="4" RadiusY="4" Margin="0,0,5,0"/>
                            <TextBlock Text="Tapa abierta" FontSize="13" VerticalAlignment="Center"/>
                        </WrapPanel>
                        <TextBlock Grid.Row="3" x:Name="SensorTimeText" Visibility="Collapsed"/>
                    </Grid>

                    <!-- Derecha: indicadores -->
                    <UniformGrid Grid.Row="0" Grid.Column="2" x:Name="SensorTiles" Columns="1"/>

                    <!-- Detalle -->
                    <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource Label}" Text="Estado del validador"/>
                            <TextBlock x:Name="SensorProcText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,6" Text="Sin lectura"/>
                            <TextBlock Style="{StaticResource Label}" Text="Atascos y errores"/>
                            <TextBlock x:Name="SensorErrText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,6" Text="—"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Label}" Text="Caja fuerte y bolsa"/>
                            <TextBlock x:Name="SensorCoverText" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,6" Text="—"/>
                            <TextBlock Style="{StaticResource Label}" Text="Sensores tapados"/>
                            <TextBlock x:Name="SensorCoveredText" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,6" Text="—"/>
                        </StackPanel>
                    </Grid>

                </Grid>
            </TabItem>

            <!-- MANTENIMIENTO -->
            <TabItem Header="Mantenimiento">
                <StackPanel Margin="24" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource H1}" Text="Herramientas"/>
                    <Button Content="EXPORTAR BUNDLE DE DIAGNÓSTICO (ZIP)" Style="{StaticResource Primary}" Click="Export_Click" HorizontalAlignment="Left" MinWidth="360"/>
                    <TextBlock FontSize="13" Foreground="{StaticResource Muted}" Margin="6,0,0,16" TextWrapping="Wrap"
                               Text="Junta los logs de esta app, los del Service Provider SNBC y datos del equipo para enviarlos a soporte Feedbill."/>
                    <Button Content="ABRIR CARPETA DE LOGS" Click="OpenLogs_Click" HorizontalAlignment="Left" MinWidth="360"/>
                    <Button Content="LEER CAPABILITIES DEL EQUIPO" Click="Caps_Click" HorizontalAlignment="Left" MinWidth="360"/>
                    <TextBlock Style="{StaticResource Label}" Text="Log" Margin="0,16,0,4"/>
                    <TextBox x:Name="LogBox" Height="260" Width="900" HorizontalAlignment="Left" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" Background="#111" Foreground="#DDD" Padding="8"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
